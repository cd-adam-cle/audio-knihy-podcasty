# Zkopíruj jako app/.env a doplň (soubor .env je v .gitignore a nikdy se necommituje).
# Cloudflare dashboard > R2 > (tvůj bucket) a > Manage R2 API Tokens (oprávnění Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=audioknihy
# Veřejná adresa bucketu: bucket > Settings > Public access > R2.dev subdomain (bez lomítka na konci)
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev
